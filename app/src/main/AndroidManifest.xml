<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- الشبكة: اختيارية تمامًا؛ كل المحتوى (القرآن والأذكار) مضمّن داخل التطبيق ويعمل بدون إنترنت -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- الموقع الجغرافي: لحساب مواقيت الصلاة واتجاه القبلة بدقة حسب موقع المستخدم -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- الإشعارات على أندرويد 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- إعادة جدولة التذكيرات بعد إعادة التشغيل -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- المنبّهات الدقيقة للتذكيرات في وقت محدد -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- إبقاء المعالج مستيقظًا أثناء تشغيل التنبيه -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- المسبحة العائمة فوق شاشة الهاتف -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- استثناء من تحسين البطارية حتى لا يتوقف تشغيل الأذكار في الخلفية -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- إعادة جدولة كل التذكيرات بعد إعادة تشغيل الجهاز -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- مستقبل التذكيرات المجدولة -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- مستقبل منبّه وقت الأذكار اليومي (إشعارات صوتية تلقائية) -->
        <receiver
            android:name=".receiver.AzkarAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- منبه مستقل لتشغيل التسجيلات البشرية بحسب الفاصل الذي يختاره المستخدم -->
        <receiver
            android:name=".receiver.HumanAzkarAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- منبّه تلقائي لمواعيد الصلوات الخمس -->
        <receiver
            android:name=".receiver.PrayerAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- تُشغّل فقط استجابةً لضغط المستخدم، ولا تبدأ من مستقبِل الإقلاع -->
        <service
            android:name=".service.AudioAzkarPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- المسبحة العائمة: نافذة نظام فوق بقية التطبيقات -->
        <service
            android:name=".service.FloatingTasbeehService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_tasbeeh" />
        </service>

    </application>

</manifest>
